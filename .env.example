# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Deployment only: the public https:// address, and True when HTTPS is handled by a proxy
CSRF_TRUSTED_ORIGINS=
BEHIND_HTTPS_PROXY=False
FRONTEND_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=CampusConnect <noreply@localhost>
PASSWORD_RESET_TIMEOUT=3600

# MySQL (used after the initial SQLite phase)
DATABASE_NAME=campusconnect
DATABASE_USER=campusconnect_user
DATABASE_PASSWORD=replace-with-your-local-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

# React
VITE_API_BASE_URL=http://127.0.0.1:8000/api
